rules_version = '2';
// Luật bảo mật Firestore cho app IMs. Dán toàn bộ file này vào Firebase console → Firestore Database → Rules → Publish.
// Học sinh chỉ đọc/ghi hồ sơ và tiến độ của chính mình; gói học (plans) chỉ quản trị ghi được; tài khoản quản trị tạo tay trong console (collection admins, document id = UID).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function okProfile(d) {
      return d.keys().hasOnly(['name', 'grade', 'school', 'email', 'createdAt', 'lastSeen'])
        && (!('name' in d) || (d.name is string && d.name.size() <= 60))
        && (!('school' in d) || (d.school is string && d.school.size() <= 80))
        && (!('grade' in d) || d.grade in [10, 11, 12])
        && (!('email' in d) || d.email is string);
    }

    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isMe(uid) && okProfile(request.resource.data);
      allow delete: if isAdmin();
    }
    match /progress/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['v', 'json', 'dev', 'updatedAt'])
        && request.resource.data.json is string && request.resource.data.json.size() < 900000;
      allow delete: if isAdmin();
    }
    match /plans/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
